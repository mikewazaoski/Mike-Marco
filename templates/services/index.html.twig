{% extends 'base.html.twig' %}

{% block title %}Services - The Pet Pantry{% endblock %}

{% block stylesheets %}
<style>
    body {
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(135deg, #F3E5AB 0%, #EDC9AF 50%, #DEB887 100%);
        color: #3E2723;
        min-height: 100vh;
        line-height: 1.6;
    }

    /* Floating Elements */
    .floating-elements {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: -1;
        overflow: hidden;
    }

    .floating-paw {
        position: absolute;
        opacity: 0.1;
        animation: float 15s infinite ease-in-out;
        font-size: 2rem;
    }

    .floating-paw:nth-child(1) { top: 10%; left: 10%; animation-delay: 0s; }
    .floating-paw:nth-child(2) { top: 20%; right: 15%; animation-delay: 5s; }
    .floating-paw:nth-child(3) { bottom: 20%; left: 20%; animation-delay: 10s; }
    .floating-paw:nth-child(4) { bottom: 10%; right: 10%; animation-delay: 7s; }

    @keyframes float {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-20px) rotate(5deg); }
    }

    /* Hero Section */
    .hero-section {
        background: linear-gradient(135deg, rgba(141, 110, 99, 0.9), rgba(109, 76, 65, 0.9)),
                    url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 400"><defs><pattern id="services" patternUnits="userSpaceOnUse" width="100" height="100"><circle cx="25" cy="25" r="3" fill="%23FFF8E1" opacity="0.1"/><circle cx="75" cy="75" r="2" fill="%23F5DEB3" opacity="0.1"/></pattern></defs><rect width="100%" height="100%" fill="url(%23services)"/></svg>');
        background-size: cover;
        background-position: center;
        padding: 100px 0;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .hero-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: radial-gradient(circle at 50% 50%, rgba(255, 248, 225, 0.2) 0%, transparent 70%);
        animation: pulse 4s ease-in-out infinite;
    }

    @keyframes pulse {
        0%, 100% { transform: scale(1); opacity: 0.3; }
        50% { transform: scale(1.1); opacity: 0.1; }
    }

    .hero-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 20px;
        position: relative;
        z-index: 2;
    }

    .hero-section h1 {
        font-size: 3.5rem;
        font-weight: 700;
        color: #FFF8E1;
        margin-bottom: 20px;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .hero-section p {
        font-size: 1.3rem;
        color: #F5DEB3;
        margin-bottom: 30px;
        opacity: 0.9;
    }

    .hero-icon {
        font-size: 5rem;
        margin-bottom: 30px;
        display: block;
        animation: bounce 2s infinite;
    }

    @keyframes bounce {
        0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
        40% { transform: translateY(-15px); }
        60% { transform: translateY(-8px); }
    }

    /* Main Container */
    .container {
        max-width: 1200px;
        margin: -60px auto 0;
        padding: 0 20px;
        position: relative;
        z-index: 1;
    }

    /* Services Grid */
    .services-section {
        margin-bottom: 80px;
    }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 40px;
        margin-top: 40px;
    }

    .service-card {
        background: rgba(255, 248, 225, 0.95);
        backdrop-filter: blur(15px);
        padding: 40px;
        border-radius: 25px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        border: 2px solid rgba(237, 201, 175, 0.3);
        transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
        position: relative;
        overflow: hidden;
        text-align: center;
    }

    .service-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(240, 230, 140, 0.3), transparent);
        transition: left 0.6s;
    }

    .service-card:hover::before {
        left: 100%;
    }

    .service-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 30px 60px rgba(0,0,0,0.15);
        background: rgba(255, 248, 225, 1);
    }

    .service-icon {
        font-size: 4rem;
        margin-bottom: 20px;
        display: block;
        animation: serviceFloat 3s ease-in-out infinite;
    }

    .service-card:nth-child(2) .service-icon { animation-delay: 0.5s; }
    .service-card:nth-child(3) .service-icon { animation-delay: 1s; }
    .service-card:nth-child(4) .service-icon { animation-delay: 1.5s; }
    .service-card:nth-child(5) .service-icon { animation-delay: 2s; }
    .service-card:nth-child(6) .service-icon { animation-delay: 2.5s; }

    @keyframes serviceFloat {
        0%, 100% { transform: translateY(0px) scale(1); }
        50% { transform: translateY(-8px) scale(1.05); }
    }

    .service-title {
        font-size: 1.8rem;
        font-weight: 600;
        color: #4E342E;
        margin-bottom: 15px;
    }

    .service-description {
        color: #5D4037;
        margin-bottom: 20px;
        line-height: 1.7;
    }

    .service-features {
        list-style: none;
        padding: 0;
        margin: 20px 0;
        text-align: left;
    }

    .service-features li {
        color: #5D4037;
        margin-bottom: 8px;
        position: relative;
        padding-left: 25px;
    }

    .service-features li::before {
        content: '✓';
        position: absolute;
        left: 0;
        color: #8D6E63;
        font-weight: bold;
    }

    .service-price {
        font-size: 1.5rem;
        font-weight: 700;
        color: #6D4C41;
        margin: 20px 0;
    }

    .service-btn {
        background: linear-gradient(45deg, #8D6E63, #6D4C41);
        color: #FFF8E1;
        padding: 12px 25px;
        border-radius: 30px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-block;
        border: none;
        cursor: pointer;
    }

    .service-btn:hover {
        background: linear-gradient(45deg, #A1887F, #8D6E63);
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(109, 76, 65, 0.3);
    }

    /* Special Offers Section */
    .special-offers {
        background: linear-gradient(135deg, rgba(255, 224, 178, 0.8), rgba(255, 204, 128, 0.8));
        padding: 60px 40px;
        border-radius: 25px;
        margin: 80px 0;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .special-offers::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,248,225,0.1) 0%, transparent 70%);
        animation: specialPulse 5s ease-in-out infinite;
    }

    @keyframes specialPulse {
        0%, 100% { transform: scale(1) rotate(0deg); opacity: 0.3; }
        50% { transform: scale(1.2) rotate(180deg); opacity: 0.1; }
    }

    .special-offers h2 {
        font-size: 2.5rem;
        font-weight: 700;
        color: #3E2723;
        margin-bottom: 20px;
        position: relative;
        z-index: 2;
    }

    .special-offers p {
        font-size: 1.2rem;
        color: #4E342E;
        margin-bottom: 30px;
        position: relative;
        z-index: 2;
    }

    .offers-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 30px;
        margin-top: 40px;
    }

    .offer-item {
        background: rgba(255, 248, 225, 0.9);
        padding: 30px 20px;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        position: relative;
        z-index: 2;
    }

    .offer-icon {
        font-size: 3rem;
        margin-bottom: 15px;
        display: block;
    }

    .offer-title {
        font-size: 1.3rem;
        font-weight: 600;
        color: #4E342E;
        margin-bottom: 10px;
    }

    .offer-description {
        color: #5D4037;
        font-size: 0.95rem;
    }

    /* Process Section */
    .process-section {
        margin: 80px 0;
    }

    .process-title {
        text-align: center;
        font-size: 2.5rem;
        font-weight: 700;
        color: #3E2723;
        margin-bottom: 50px;
    }

    .process-steps {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 40px;
    }

    .process-step {
        text-align: center;
        position: relative;
    }

    .process-step::after {
        content: '';
        position: absolute;
        top: 25px;
        right: -20px;
        width: 40px;
        height: 2px;
        background: linear-gradient(90deg, #D2B48C, #F5DEB3);
        display: none;
    }

    .process-step:not(:last-child)::after {
        display: block;
    }

    .step-number {
        width: 60px;
        height: 60px;
        background: linear-gradient(45deg, #8D6E63, #6D4C41);
        color: #FFF8E1;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0 auto 20px;
        box-shadow: 0 5px 15px rgba(109, 76, 65, 0.3);
    }

    .step-title {
        font-size: 1.3rem;
        font-weight: 600;
        color: #4E342E;
        margin-bottom: 10px;
    }

    .step-description {
        color: #5D4037;
        line-height: 1.6;
    }

    /* CTA Section */
    .cta-section {
        background: linear-gradient(135deg, #6D4C41, #4E342E);
        padding: 60px 40px;
        border-radius: 25px;
        text-align: center;
        color: #FFF8E1;
        margin: 80px 0;
    }

    .cta-section h2 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .cta-section p {
        font-size: 1.2rem;
        margin-bottom: 30px;
        opacity: 0.9;
    }

    .cta-buttons {
        display: flex;
        gap: 20px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .cta-btn {
        background: linear-gradient(45deg, #FFE0B2, #F5DEB3);
        color: #4E342E;
        padding: 15px 30px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 700;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .cta-btn:hover {
        background: linear-gradient(45deg, #FFCC80, #FFE0B2);
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(255, 224, 178, 0.4);
    }

    /* Responsive Design */
    @media (max-width: 768px) {
        .hero-section h1 {
            font-size: 2.5rem;
        }

        .hero-section p {
            font-size: 1.1rem;
        }

        .services-grid {
            grid-template-columns: 1fr;
            gap: 30px;
        }

        .process-step::after {
            display: none;
        }

        .cta-buttons {
            flex-direction: column;
            align-items: center;
        }
    }

    @media (max-width: 480px) {
        .hero-section h1 {
            font-size: 2rem;
        }

        .service-card {
            padding: 25px;
        }

        .special-offers {
            padding: 40px 20px;
        }

        .footer-container {
            grid-template-columns: 1fr;
            gap: 30px;
            text-align: center;
        }

        .newsletter-form {
            flex-direction: column;
        }

        .newsletter-input {
            min-width: 100%;
        }

        .footer-bottom-links {
            flex-direction: column;
            gap: 10px;
        }
    }
</style>
{% endblock %}

{% block body %}
    <div class="floating-elements">
        <div class="floating-paw">🐾</div>
        <div class="floating-paw">🐾</div>
        <div class="floating-paw">🐾</div>
        <div class="floating-paw">🐾</div>
    </div>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-container">
            <span class="hero-icon">🚚</span>
            <h1>Our Services</h1>
            <p>Convenient home delivery service for all your pet essentials. Quality products delivered safely to your doorstep.</p>
        </div>
    </section>

    <div class="container">
        <!-- Main Services -->
        <section class="services-section">
            <div class="services-grid">
                <!-- Home Delivery -->
                <div class="service-card" style="grid-column: 1 / -1; max-width: 600px; margin: 0 auto;">
                    <span class="service-icon">🚚</span>
                    <h3 class="service-title">Home Delivery Service</h3>
                    <p class="service-description">Convenient delivery of pet supplies, food, and essentials right to your doorstep. Shop from our complete range of pet products and have them delivered safely to your home.</p>
                    
                    <ul class="service-features">
                        <li>Same-day delivery available</li>
                        <li>Scheduled recurring deliveries</li>
                        <li>Free delivery on orders over P50</li>
                        <li>Contactless delivery options</li>
                        <li>Real-time delivery tracking</li>
                        <li>Carefully packaged pet food and supplies</li>
                        <li>Temperature-controlled delivery for sensitive items</li>
                        <li>Flexible delivery time slots</li>
                    </ul>
                    
                    <div class="service-price">FREE delivery on orders 50 pesos</div>
                    <a href="#" class="service-btn">Start Shopping & Order</a>
                </div>
            </div>
        </section>

        <!-- Special Offers -->
        <section class="special-offers">
            <h2>🎉 Special Delivery Offers</h2>
            <p>Save more with our bundled delivery services and seasonal promotions!</p>
            
            <div class="offers-grid">
                <div class="offer-item">
                    <span class="offer-icon">💰</span>
                    <h4 class="offer-title">First Order Discount</h4>
                    <p class="offer-description">Get 15% off your first order plus free delivery regardless of order amount.</p>
                </div>
                
                <div class="offer-item">
                    <span class="offer-icon">📅</span>
                    <h4 class="offer-title">Monthly Subscription</h4>
                    <p class="offer-description">Subscribe for monthly deliveries and save 10% on all orders with guaranteed free delivery.</p>
                </div>
                
                <div class="offer-item">
                    <span class="offer-icon">⚡</span>
                    <h4 class="offer-title">Same-Day Rush</h4>
                    <p class="offer-description">Need supplies today? Same-day delivery available for orders placed before 2 PM.</p>
                </div>
            </div>
        </section>

        <!-- Process Section -->
        <section class="process-section">
            <h2 class="process-title">How to Order - Simple Steps</h2>
            <div class="process-steps">
                <div class="process-step">
                    <div class="step-number">1</div>
                    <h4 class="step-title">Browse Products</h4>
                    <p class="step-description">Browse our extensive catalog of pet food, accessories, toys, and health essentials online</p>
                </div>
                
                <div class="process-step">
                    <div class="step-number">2</div>
                    <h4 class="step-title">Add to Cart</h4>
                    <p class="step-description">Select the items your pet needs and add them to your shopping cart with desired quantities</p>
                </div>
                
                <div class="process-step">
                    <div class="step-number">3</div>
                    <h4 class="step-title">Checkout & Pay</h4>
                    <p class="step-description">Enter your delivery details, choose payment method, and complete your secure checkout</p>
                </div>
                
                <div class="process-step">
                    <div class="step-number">4</div>
                    <h4 class="step-title">Fast Delivery</h4>
                    <p class="step-description">Receive your order at your doorstep with real-time tracking and careful packaging</p>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="cta-section">
            <h2>Ready to Order Pet Supplies?</h2>
            <p>Start shopping now and get your pet essentials delivered right to your door</p>
            
            <div class="cta-buttons">
                <a href="#" class="cta-btn">
                    🛒 Start Shopping
                </a>
                <a href="#" class="cta-btn">
                    📞 Call to Order
                </a>
                <a href="#" class="cta-btn">
                    💬 Ask Questions
                </a>
            </div>
        </section>sy
    </div>
{% endblock %}