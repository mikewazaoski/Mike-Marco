{% extends 'base.html.twig' %}

{% block title %}About Us - The Pet Pantry{% endblock %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(135deg, #F3E5AB 0%, #EDC9AF 50%, #DEB887 100%);
        color: #3E2723;
        min-height: 100vh;
        line-height: 1.6;
    }

    .floating-elements {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: -1;
        overflow: hidden;
    }

    .floating-paw {
        position: absolute;
        opacity: 0.1;
        animation: float 15s infinite ease-in-out;
        font-size: 2rem;
    }

    .floating-paw:nth-child(1) { top: 10%; left: 10%; animation-delay: 0s; }
    .floating-paw:nth-child(2) { top: 20%; right: 15%; animation-delay: 5s; }
    .floating-paw:nth-child(3) { bottom: 20%; left: 20%; animation-delay: 10s; }
    .floating-paw:nth-child(4) { bottom: 10%; right: 10%; animation-delay: 7s; }

    @keyframes float {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-20px) rotate(5deg); }
    }

    header {
        background: linear-gradient(45deg, #8D6E63, #6D4C41);
        padding: 60px 20px;
        text-align: center;
        color: #FFF8E1;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }

    header::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,248,225,0.1) 0%, transparent 70%);
        animation: pulse 4s ease-in-out infinite;
    }

    @keyframes pulse {
        0%, 100% { transform: scale(1); opacity: 0.3; }
        50% { transform: scale(1.1); opacity: 0.1; }
    }

    header h1 {
        font-size: 3.5rem;
        font-weight: 700;
        margin-bottom: 10px;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        position: relative;
        z-index: 2;
    }

    header p {
        font-size: 1.2rem;
        font-weight: 300;
        opacity: 0.9;
        position: relative;
        z-index: 2;
    }

    .container {
        max-width: 1200px;
        margin: -40px auto 0;
        padding: 0 20px;
        position: relative;
        z-index: 1;
    }

    .content-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 40px;
    }

    .card {
        background: rgba(255, 248, 225, 0.95);
        backdrop-filter: blur(10px);
        padding: 40px;
        border-radius: 24px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        border: 1px solid rgba(237, 201, 175, 0.3);
        transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
        position: relative;
        overflow: hidden;
    }

    .card::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(237, 201, 175, 0.2), transparent);
        transition: left 0.6s;
    }

    .card:hover::before {
        left: 100%;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 30px 60px rgba(0,0,0,0.15);
    }

    .card h2 {
        color: #4E342E;
        font-size: 2.2rem;
        font-weight: 600;
        margin-bottom: 20px;
        position: relative;
    }

    .card h2::after {
        content: '';
        position: absolute;
        bottom: -8px;
        left: 0;
        width: 60px;
        height: 3px;
        background: linear-gradient(90deg, #D2B48C, #F5DEB3);
        border-radius: 2px;
    }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-top: 30px;
    }

    .service-item {
        background: rgba(240, 230, 140, 0.3);
        padding: 25px;
        border-radius: 16px;
        border-left: 5px solid #8D6E63;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .service-item:hover {
        background: rgba(240, 230, 140, 0.5);
        transform: translateX(5px);
    }

    .service-icon {
        font-size: 2rem;
        margin-bottom: 10px;
        display: block;
    }

    .service-item h3 {
        color: #4E342E;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .service-item p {
        color: #5D4037;
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 15px;
    }

    .highlight-section {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 30px;
        margin-top: 40px;
    }

    .highlight-card {
        background: linear-gradient(135deg, #FFE0B2 0%, #FFCC80 100%);
        padding: 35px;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        border: 2px solid rgba(237, 201, 175, 0.5);
        position: relative;
        overflow: hidden;
    }

    .highlight-card::before {
        content: '';
        position: absolute;
        top: -2px;
        left: -2px;
        right: -2px;
        bottom: -2px;
        background: linear-gradient(45deg, #D2B48C, #F5DEB3, #D2B48C);
        z-index: -1;
        border-radius: 22px;
    }

    .highlight-card h3 {
        color: #3E2723;
        font-size: 1.8rem;
        font-weight: 600;
        margin-bottom: 15px;
    }

    .highlight-card p {
        color: #4E342E;
        font-size: 1.05rem;
        line-height: 1.7;
    }

    .stats-section {
        background: rgba(255, 248, 225, 0.8);
        padding: 40px;
        border-radius: 20px;
        margin-top: 40px;
        text-align: center;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 30px;
        margin-top: 30px;
    }

    .stat-item {
        padding: 20px;
    }

    .stat-number {
        font-size: 3rem;
        font-weight: 700;
        color: #6D4C41;
        margin-bottom: 10px;
        display: block;
    }

    .stat-label {
        color: #5D4037;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.9rem;
    }

    footer {
        margin-top: 80px;
        background: linear-gradient(45deg, #3E2723, #4E342E);
        color: #FFF8E1;
        text-align: center;
        padding: 40px 20px;
        position: relative;
    }

    footer::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #D2B48C, #F5DEB3, #D2B48C);
    }

    .footer-content {
        max-width: 1200px;
        margin: 0 auto;
    }

    .footer-links {
        margin-bottom: 20px;
    }

    .footer-links a {
        color: #F5DEB3;
        text-decoration: none;
        margin: 0 15px;
        transition: color 0.3s ease;
    }

    .footer-links a:hover {
        color: #FFF8E1;
    }

    ul {
        margin: 15px 0 20px 20px;
        padding: 0;
    }

    li {
        margin-bottom: 8px;
        line-height: 1.6;
    }

    p {
        line-height: 1.6;
        margin-bottom: 15px;
    }

    .scroll-indicator {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: rgba(109, 76, 65, 0.2);
        z-index: 1000;
    }

    .scroll-progress {
        height: 100%;
        background: linear-gradient(90deg, #6D4C41, #8D6E63);
        width: 0%;
        transition: width 0.1s ease;
    }

    @media (max-width: 768px) {
        header h1 {
            font-size: 2.5rem;
        }
        
        header p {
            font-size: 1rem;
        }
        
        .card {
            padding: 25px;
        }
        
        .services-grid {
            grid-template-columns: 1fr;
        }
        
        .highlight-section {
            grid-template-columns: 1fr;
        }
        
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 480px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
{% endblock %}

{% block body %}
    <div class="scroll-indicator">
        <div class="scroll-progress" id="scrollProgress"></div>
    </div>

    <div class="floating-elements">
        <div class="floating-paw">🐾</div>
        <div class="floating-paw">🐾</div>
        <div class="floating-paw">🐾</div>
        <div class="floating-paw">🐾</div>
    </div>

    <header>
        <h1>Pets Pantry</h1>
        <p>Where happy pets begins</p>
    </header>

    <div class="container">
        <div class="content-grid">
            <div class="card">
                <h2>Our Story</h2>
                <p>
                    The Pet Pantry was born out of love for our own pets—a playful Labrador and a gentle cat. Their colors, personalities, and loyalty inspired us to create a store that provides only the best for every pet. Just like how our pets bring joy and comfort to our lives, we aim to bring the same happiness to yours by offering essentials that keep them healthy, cared for, and loved.
                </p>
            </div>

            <div class="card">
                <h2>Who We Are</h2>
                <p>
                    We are more than just a pet essentials store—we are a community that values the bond between pets and their owners. At The Pet Pantry, we carefully select products that are safe, affordable, and reliable, because we believe pets deserve nothing less. We are committed to being every pet owner's partner in providing care, love, and comfort.
                </p>
            </div>

            <div class="card">
                <h2>What We Offer</h2>
                <p>Our carefully curated selection of pet essentials is designed to meet all your pet's needs:</p>
                
                <div class="services-grid">
                    <div class="service-item">
                        <span class="service-icon">🍽️</span>
                        <h3>Nutritious Food</h3>
                        <p>Premium quality food for dogs, cats, birds, and other beloved pets to keep them healthy and energetic.</p>
                    </div>
                    
                    <div class="service-item">
                        <span class="service-icon">🧼</span>
                        <h3>Grooming Supplies</h3>
                        <p>Complete grooming essentials to keep your pets clean, comfortable, and looking their absolute best.</p>
                    </div>
                    
                    <div class="service-item">
                        <span class="service-icon">🎾</span>
                        <h3>Accessories</h3>
                        <p>Fun toys, stylish collars, durable leashes, cozy beds, and everything else to pamper your pets.</p>
                    </div>
                    
                    <div class="service-item">
                        <span class="service-icon">💊</span>
                        <h3>Health Essentials</h3>
                        <p>Vitamins, supplements, and preventive care items to support your pet's long-term health and wellness.</p>
                    </div>
                </div>
            </div>

            <div class="stats-section">
                <h2>Our Goals & Commitments</h2>
                <div class="stats-grid">
                    <div class="stat-item">
                       <span class="service-icon">🏆</span
                        <span class="stat-label">Expand Quality Range</span>
                    </div>
                    <div class="stat-item">
                        <span class="service-icon">🤝</span>
                        <span class="stat-label">Build Strong Relationships</span>
                    </div>
                    <div class="stat-item">
                        <span class="service-icon">💰</span>
                        <span class="stat-label">Affordable Quality</span>
                    </div>
                    <div class="stat-item">
                        <span class="service-icon">📱</span>
                        <span class="stat-label">Embrace Technology</span>
                    </div>
                </div>
            </div>

            <div class="highlight-section">
                <div class="highlight-card">
                    <h3>🎯 Our Mission</h3>
                    <p>
                        Our mission is to provide high-quality and affordable essentials that make pet care simple and stress-free. We aim to support pet owners in giving their companions the best possible care—ensuring pets live healthier, happier, and longer lives.
                    </p>
                </div>

                <div class="highlight-card">
                    <h3>🌟 Our Vision</h3>
                    <p>
                        We envision The Pet Pantry as the most trusted and reliable pet essentials provider in the community. Our dream is to create a future where every household with pets turns to The Pet Pantry as their first choice for safe, affordable, and high-quality products.
                    </p>
                </div>
            </div>

            <div class="card">
                <h2>Our Goals</h2>
                <ul>
                    <li><strong>Expand our range</strong> of pet essentials while maintaining consistent quality.</li>
                    <li><strong>Build strong relationships</strong> with pet owners through excellent service.</li>
                    <li><strong>Keep products affordable</strong> without compromising safety or reliability.</li>
                    <li><strong>Promote responsible pet ownership</strong> in our community.</li>
                    <li><strong>Embrace technology</strong> to improve inventory, sales, and customer experience.</li>
                    <li><strong>Grow sustainably</strong> to reach more households and support more pets each year.</li>
                </ul>
            </div>
        </div>
    </div>

    <footer>
        <div class="footer-content">
            <div class="footer-links">
                <a href="#home">Home</a>
                <a href="#contact">Contact</a>
            </div>
            <p>&copy; {{ "now"|date("Y") }} The Pet Pantry. All rights reserved. Made with ❤️ for pets and their families.</p>
        </div>
    </footer>

    <script>
        // Scroll progress indicator
        window.addEventListener('scroll', () => {
            const scrollTop = document.documentElement.scrollTop;
            const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrollPercent = (scrollTop / scrollHeight) * 100;
            document.getElementById('scrollProgress').style.width = scrollPercent + '%';
        });

        // Add smooth scroll behavior to footer links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Animate stats numbers on scroll
        const observerOptions = {
            threshold: 0.5,
            rootMargin: '0px 0px -50px 0px'
        };

        const statsObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const statNumbers = entry.target.querySelectorAll('.stat-number');
                    statNumbers.forEach(stat => {
                        const finalNumber = parseInt(stat.textContent);
                        let currentNumber = 0;
                        const increment = finalNumber / 50;
                        
                        const timer = setInterval(() => {
                            currentNumber += increment;
                            if (currentNumber >= finalNumber) {
                                stat.textContent = finalNumber + '+';
                                clearInterval(timer);
                            } else {
                                stat.textContent = Math.floor(currentNumber) + '+';
                            }
                        }, 30);
                    });
                    statsObserver.unobserve(entry.target);
                }
            });
        }, observerOptions);

        const statsSection = document.querySelector('.stats-section');
        if (statsSection) {
            statsObserver.observe(statsSection);
        }
    </script>
{% endblock %}